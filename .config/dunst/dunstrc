[global]
    # Geometry & Position
    width = (0, 350)
    height = (0, 150)
    offset = (20, 50)
    origin = top-right

    # Sharp Edges (No Rounding)
    corner_radius = 0
    frame_width = 2
    gap_size = 5

    # Icons
	enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Papirus
    icon_position = left
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus/16x16/status/:/usr/share/icons/Papirus/16x16/devices/:/usr/share/icons/Papirus/16x16/apps/

    # Fonts & Padding
    font = JetBrainsMono Nerd Font 13
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10

[urgency_low]
    background = "#121212"
    foreground = "#a0a0a0"
    frame_color = "#2a2a2a"
    timeout = 5

[urgency_normal]
    background = "#181818"
    foreground = "#e0e0e0"
    frame_color = "#4e4e4e"
    timeout = 8

[urgency_critical]
    background = "#242424"
    foreground = "#ffffff"
    frame_color = "#8e8e8e"
    timeout = 0
