#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

xrandr --output HDMI-0 --mode 1920x1080 --rate 100
xsetroot -cursor_name left_ptr &
$HOME/.config/polybar/launch.sh &
nm-applet &
blueman-applet &
dunst &
nitrogen --restore &
picom &
thunar --daemon &
otd-daemon &


bspc monitor -d 1 2 3 4 5 6 7 8 9 

bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio          0.5
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true

bspc config top_padding 33


bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a qBittorrent state=floating center=on rectangle=800x600
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a firefox-esr state=floating
bspc rule -a Thunar state=floating rectangle=960x640
bspc rule -a Nwg-look state=floating
 
